<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="iris-history-monitor.ZPM">
    <Module>
      <Name>iris-history-monitor</Name>
      <Version>1.9.0</Version>
      <Description>IRIS History Monitor is now using the IRIS /api/monitor Service</Description>
      <Packaging>module</Packaging>
      <SourcesRoot>src</SourcesRoot>
      <Resource Name="diashenrique.historymonitor.dashboard.PKG"/>
      <Resource Name="diashenrique.historymonitor.util.PKG"/>
      <Resource Name="diashenrique.historymonitor.api.PKG"/>
      <Resource Name="diashenrique.historymonitor.service.PKG"/>
      <Resource Name="diashenrique.historymonitor.web.PKG"/>
      <Invokes>
        <Invoke Class="diashenrique.historymonitor.util.Security" Method="Setup" Phase="Compile" When="After"></Invoke>
        <Invoke Class="diashenrique.historymonitor.util.customSensors" Method="CustomApplicationMetrics"></Invoke>
        <!-- Compile the old pages at install: IRIS otherwise compiles a .csp page on its first request, which
             fails with 404 for a user without development rights (spec 002 FR-024: they stay reachable). -->
        <Invoke Class="%SYSTEM.CSP" Method="LoadPageDir">
          <Arg>/csp/irismonitor/</Arg>
          <Arg>ck</Arg>
        </Invoke>
        <Invoke Class="diashenrique.historymonitor.util.Favorite" Method="%AddFavorite">
          <Arg>HistoryMonitor</Arg>
          <Arg>/historymonitor/index.html</Arg>
        </Invoke>
      </Invokes>
      <CSPApplication
        Url="/csp/irismonitor"
        Path="/src/csp"
        Directory="{$cspdir}/irismonitor"
        ServeFiles="1"
        Recurse="1"
        CookiePath="/csp/irismonitor"
        UseCookies="2"
        MatchRoles=":%DB_${Namespace}"
        PasswordAuthEnabled="1"
        UnauthenticatedEnabled="0"
       />
      <!-- The new interface (spec 002) and the API share the prefix /historymonitor/ and its session
           cookie, so one sign-in covers both and no other application sees the session (research R3). -->
      <CSPApplication
        Url="/historymonitor"
        Path="/src/web/historymonitor"
        Directory="{$cspdir}/historymonitor"
        ServeFiles="1"
        Recurse="1"
        CookiePath="/historymonitor/"
        UseCookies="2"
        MatchRoles=":%DB_${Namespace}"
        PasswordAuthEnabled="1"
        UnauthenticatedEnabled="0"
       />
      <WebApplication
        Url="/historymonitor/api/v1"
        DispatchClass="diashenrique.historymonitor.api.Dispatch"
        MatchRoles=":%DB_${Namespace}"
        AutheEnabled="32"
        CookiePath="/historymonitor/"
        UseCookies="2"
       />
    </Module>
  </Document>
</Export>
