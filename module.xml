<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="iris-history-monitor.ZPM">
    <Module>
      <Name>iris-history-monitor</Name>
      <Version>2.0.0</Version>
      <Description>IRIS History Monitor is now using the IRIS /api/monitor Service</Description>
      <Packaging>module</Packaging>
      <SourcesRoot>src</SourcesRoot>
      <Resource Name="diashenrique.historymonitor.util.PKG"/>
      <Resource Name="diashenrique.historymonitor.api.PKG"/>
      <Resource Name="diashenrique.historymonitor.service.PKG"/>
      <Resource Name="diashenrique.historymonitor.web.PKG"/>
      <Invokes>
        <Invoke Class="diashenrique.historymonitor.util.Security" Method="Setup" Phase="Compile" When="After"></Invoke>
        <Invoke Class="diashenrique.historymonitor.util.customSensors" Method="CustomApplicationMetrics"></Invoke>
        <!-- Removes what the old pages of 1.x left (spec 003 FR-005, research R3, R4): on install and
             upgrade after Activate, and on uninstall before Unconfigure. Idempotent. -->
        <Invoke Class="diashenrique.historymonitor.util.Retire" Method="Run" Phase="Activate" When="After"></Invoke>
        <Invoke Class="diashenrique.historymonitor.util.Retire" Method="Run" Phase="Unconfigure" When="Before"></Invoke>
        <Invoke Class="diashenrique.historymonitor.util.Favorite" Method="%AddFavorite">
          <Arg>HistoryMonitor</Arg>
          <Arg>/historymonitor/index.html</Arg>
        </Invoke>
      </Invokes>
      <!-- Web applications are <WebApplication> (IPM deprecates <CSPApplication>). It only writes the
           Security.Applications properties, so the interface files are copied by <FileCopy> and Path points
           at where they land. -->
      <FileCopy Name="src/web/historymonitor/" Target="${cspdir}historymonitor/"/>
      <!-- The old prefix only forwards to the new monitor (spec 003 FR-002, contracts/forwarding.md). No
           sign-in: the class reads nothing and only redirects; the new monitor asks for sign-in. The database
           role is matched only so the unauthenticated user can run the forwarding class (research R2).
           Stays for all of 2.x (FR-003). -->
      <WebApplication
        Url="/csp/irismonitor"
        DispatchClass="diashenrique.historymonitor.web.Forward"
        AutheEnabled="64"
        MatchRoles=":%DB_${Namespace}"
        ServeFiles="0"
        AutoCompile="0"
        CookiePath="/csp/irismonitor/"
        UseCookies="2"
       />
      <!-- The new interface (spec 002) and the API share the prefix /historymonitor/ and its session
           cookie, so one sign-in covers both and no other application sees the session (research R3). -->
      <WebApplication
        Url="/historymonitor"
        Path="${cspdir}historymonitor/"
        ServeFiles="1"
        Recurse="1"
        CookiePath="/historymonitor/"
        UseCookies="2"
        MatchRoles=":%DB_${Namespace}"
        AutheEnabled="32"
       />
      <WebApplication
        Url="/historymonitor/api/v1"
        DispatchClass="diashenrique.historymonitor.api.Dispatch"
        MatchRoles=":%DB_${Namespace}"
        AutheEnabled="32"
        CookiePath="/historymonitor/"
        UseCookies="2"
       />
    </Module>
  </Document>
</Export>
